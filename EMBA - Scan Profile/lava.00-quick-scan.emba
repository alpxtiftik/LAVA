# EMBA - EMBEDDED LINUX ANALYZER
# Custom profile: sadece hardcoded credential / secret arama (LAVA MVP - Madde 1)

export FORMAT_LOG=1
export THREADED=6
export SHORT_PATH=1
export HTML=1

# Quick scan KAPALI: default quick scan S99/S109 gibi bizim istediğimiz
# modülleri de blackliste alıyor, o yüzden kendi blacklist'imizi tam kontrol ediyoruz
export QUICK_SCAN=0
export BINARY_EXTENDED=0
export QEMULATION=0
export VEX_METRICS=0

MODULE_BLACKLIST+=("L10_system_emulation" "L15_emulated_checks_nmap" "L20_snmp_checks" "L22_upnp_hnap_checks" "L23_vnc_checks" "L25_web_checks" "L35_metasploit_check" "L99_cleanup" "S02_UEFI_FwHunt" "S03_firmware_bin_base_analyzer" "S04_windows_basic_analysis" "S06_distribution_identification" "S07_bootloader_check" "S08_main_package_sbom" "S09_firmware_base_version_check" "S100_command_inj_check" "S10_binaries_basic_check" "S110_yara_check" "S115_usermode_emulator" "S116_qemu_version_detection" "S118_busybox_verifier" "S12_binary_protection" "S130_binary_map_builder" "S13_weak_func_check" "S14_weak_func_radare_check" "S15_radare_decompile_checks" "S16_ghidra_decompile_checks" "S17_cwe_checker" "S18_capa_checker" "S19_apk_check" "S20_shell_check" "S21_python_check" "S22_php_check" "S23_lua_check" "S24_kernel_bin_identifier" "S25_kernel_check" "S26_kernel_vuln_verifier" "S27_perl_check" "S28_java_check" "S35_http_file_check" "S36_lighttpd" "S40_weak_perm_check" "S50_authentication_check" "S55_history_file_check" "S60_cert_file_check" "S65_config_file_check" "S75_network_check" "S80_cronjob_check" "S85_ssh_check" "S90_mail_check" "S95_interesting_files_check" "S109_jtr_local_pw_cracking")

export EMBA_MAP_GENERATOR=0
export DISABLE_STATUS_BAR=0
export SILENT=1

if [[ $IN_DOCKER -ne 1 ]] ; then
  print_output "$(indent "$(orange "LAVA MVP profile - hardcoded secrets / credentials only")")" "no_log"
  print_output "$(indent "$(orange "Active modules: S05, S45, S99, S106, S107, S108, S109 (+P extraction, +F report)")")" "no_log"
  for MODULE_ in "${MODULE_BLACKLIST[@]}"; do
    print_output "$(indent "$(orange "Blacklisted module: $MODULE_")")" "no_log"
  done
  export USE_DOCKER=1
fi

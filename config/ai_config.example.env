# AI_PROVIDER secenekleri:
#   local            -> Local AI (Ollama), LOCAL_AI_* alanlarini kullanir
#   gemini           -> Google Gemini API (Cloud), GEMINI_API_KEY gerekir
#   mcp_claude       -> MCP agentic mod: Claude Code (claude) ham EMBA loglarini
#                       kendi kesfedip verdict verir. Bir kerelik `claude` login.
#   mcp_antigravity  -> MCP agentic mod: Antigravity CLI (agy). Bir kerelik `agy` login.
# MCP modlarinda LOCAL_AI_* / GEMINI_API_KEY kullanilmaz; cikti semasi ayni kalir.
LOCAL_AI_IP="127.0.0.1"
LOCAL_AI_PORT="11434"
LOCAL_AI_MODEL="qwen2.5-coder:7b"
AI_MAX_CHARS_TO_ANALYSE="5000"
AI_PROVIDER="local"
GEMINI_API_KEY=""

# MCP modu: ajan takilirsa subprocess bu sure sonunda sonlandirilip hata verilir.
AGENT_TIMEOUT_SECONDS="3600"

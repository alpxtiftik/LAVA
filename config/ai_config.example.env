# AI_PROVIDER options:
#   local            -> Local AI (Ollama), uses the LOCAL_AI_* fields
#   gemini           -> Google Gemini API (Cloud), needs GEMINI_API_KEY
#   mcp_claude       -> MCP agentic mode: Claude Code (claude) explores the raw
#                       EMBA logs itself and produces verdicts. One-time `claude` login.
#   mcp_antigravity  -> MCP agentic mode: Antigravity CLI (agy). One-time `agy` login.
# In MCP modes LOCAL_AI_* / GEMINI_API_KEY are unused; the output schema stays the same.
LOCAL_AI_IP="127.0.0.1"
LOCAL_AI_PORT="11434"
LOCAL_AI_MODEL="qwen2.5-coder:7b"
AI_MAX_CHARS_TO_ANALYSE="5000"
AI_PROVIDER="local"
GEMINI_API_KEY=""

# MCP mode: if the agent hangs, the subprocess is terminated after this many seconds and reported as an error.
AGENT_TIMEOUT_SECONDS="3600"

# MCP mode: findings are sent to the agent in batches of this size (one agent run
# per batch, all appending to the same verdicts.json). Prevents the single-turn
# timeout on large firmware. "0" disables batching (one giant turn).
MCP_BATCH_SIZE="40"

# EMBA S99_grepit coverage. grepit is a source-audit tool - most "cryptocred"
# categories match the WORD password/secret and can't tell a hardcoded value
# from ordinary code. LAVA lets the AI make that call, so the default keeps
# everything. Five levels, most permissive first:
#   raw (default) -> every cryptocred_* match. ONLY removed: lines that are
#                    unreadable binary garbage / not a real path.
#                    (DIR-880 ~3000 S99 findings -> MCP mode ~75 batches; heavy.)
#   light         -> raw, minus (a) matches inside a compiled binary's string
#                    table (*.so / ELF), (b) static web assets (minified JS
#                    libs, images, .html, locale bundles).
#   gated         -> light, and the line must look like a real assignment
#                    (key = "value" / key: value with a concrete literal).
#                    Drops x="";, if(x==""), pw=$pass, {, %s.
#   strict        -> ONLY /etc/shadow hashes + -----BEGIN ... PRIVATE KEY-----
#                    blocks. Other key=value leaks -> S107 + custom grep.
#   off           -> skip S99 entirely.
S99_SCAN="raw"

# Custom credential grep layer (optional). When "1", LAVA runs its own regex
# rules over the extracted firmware before the AI step and shows the results in
# a separate "Grep" view. "0" = the classic EMBA-only flow.
CUSTOM_GREP_ENABLED="0"
# Which profile in config/scan_profiles/ the custom grep uses.
SCAN_PROFILE="iot-testing"
